# Files executed inside the Linux container must keep LF line endings,
# even on Windows checkouts with core.autocrlf=true. The rest of the tree
# is left as upstream ships it, so merges from ellite/Wallos stay clean.
*.sh              text eol=lf
cronjobs          text eol=lf
Dockerfile        text eol=lf
nginx.conf        text eol=lf
nginx.default.conf text eol=lf
docker-compose*.yaml text eol=lf
docker-compose*.yml  text eol=lf
